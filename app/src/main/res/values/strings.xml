    <!-- FAQs -->
    <string name="faq_q1">How do I mark my attendance?</string>
    <string name="faq_a1">Point your camera at the lecturer\'s projected QR code. Once scanned, position your face in the oval guide to complete verification.</string>

    <string name="faq_q2">What if face verification fails?</string>
    <string name="faq_a2">Ensure you are in a well-lit area, look directly at the camera, and remove sunglasses or obstructions.</string>

    <string name="faq_q3">Can I scan on behalf of a classmate?</string>
    <string name="faq_a3">No. The system uses strict biometric facial recognition linked to each student\'s unique registered template.</string>

    <string name="faq_q4">How do I report an attendance dispute?</string>
    <string name="faq_a4">Navigate to the session in History, click Details, and tap \'Report a Problem\' to request lecturer/admin review.</string>

    <string name="faq_q5">What should I do if the app crashes?</string>
    <string name="faq_a5">Try restarting the app, checking your internet connection, or re-logging in.</string>
